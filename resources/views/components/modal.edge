<div x-data="{ 
    isOpen: false, 
    title: '', 
    message: '', 
    actionUrl: '',
    confirmText: 'Confirmar',
    method: 'POST'
  }" x-on:open-confirm-modal.window="
    isOpen = true; 
    title = $event.detail.title;
    message = $event.detail.message;
    actionUrl = $event.detail.actionUrl;
    confirmText = $event.detail.confirmText || 'Confirmar';
  " x-show="isOpen" class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto"
    aria-labelledby="modal-title" role="dialog" aria-modal="true" x-cloak>
    <!-- Backdrop con efecto blur -->
    <div x-show="isOpen" x-transition.opacity.duration.300ms class="fixed inset-0 bg-gray-500/75 backdrop-blur-sm"
        x-on:click="isOpen = false"></div>

    <!-- Panel del Modal -->
    <div x-show="isOpen" x-transition:enter="ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" x-transition:leave="ease-in duration-200"
        x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
        x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        class="relative z-10 w-full max-w-md p-6 bg-white rounded-2xl shadow-xl">
        <div class="flex flex-col items-center text-center">
            <!-- Icono de advertencia (Naranja para Soft Delete) -->
            <div class="flex items-center justify-center w-12 h-12 mb-4 bg-orange-100 rounded-full">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
                    </path>
                </svg>
            </div>

            <!-- Título Dinámico -->
            <h3 class="text-2xl font-serif text-[#1B3B32]" id="modal-title" x-text="title"></h3>

            <!-- Mensaje Dinámico (permite HTML para negritas) -->
            <p class="mt-3 text-sm text-gray-500 leading-relaxed" x-html="message"></p>

            <!-- Botones de Acción -->
            <div class="flex flex-col w-full gap-2 mt-8 sm:flex-row sm:justify-center">
                <button @click="isOpen = false" type="button"
                    class="inline-flex justify-center w-full px-4 py-2.5 text-sm font-medium text-gray-700 bg-gray-100 border border-transparent rounded-lg hover:bg-gray-200 transition-colors sm:w-auto cursor-pointer">
                    Cancelar
                </button>

                <!-- Formulario Dinámico -->
                <form :action="actionUrl" method="POST" class="w-full sm:w-auto">
                    {{ csrfField() }}
                    <button x-on:click="isOpen = false" type="button"
                        class="inline-flex justify-center w-full px-4 py-2.5 text-sm font-medium text-white bg-orange-600 border border-transparent rounded-lg hover:bg-orange-700 transition-colors shadow-sm sm:w-auto cursor-pointer">
                        Confirmar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>