<aside class="flex flex-col w-64 h-screen bg-[#F9F8F6] border-r border-gray-200">
    <!-- Cabecera / Logo -->
    <div class="px-6 py-8">
        <h1 class="text-2xl font-serif font-bold text-[#1B3B32]">Cumbresoft</h1>
        <p class="mt-1 text-[10px] font-semibold tracking-widest text-gray-500 uppercase">
            Panel de administrador
        </p>
    </div>

    <!-- Navegación Principal -->
    <nav class="flex-1 mt-2 space-y-1">
        <!-- Item Normal -->
        <a href="/admin/dashboard"
            class="flex items-center gap-3 px-6 py-3 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900">
            <!-- Icono: Dashboard (Placeholder) -->
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z">
                </path>
            </svg>
            <span class="font-medium text-sm">Dashboard</span>
        </a>

        <!-- Item Activo (Ejemplo: Cabañas) -->
        <a href="{{ urlFor('gestion')}}"
            class="flex items-center gap-3 px-6 py-3 text-[#1B3B32] bg-[#F0EEEB] border-l-4 border-[#1B3B32]">
            <!-- Icono: Home/Cabins -->
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
                </path>
            </svg>
            <span class="font-medium text-sm">Cabañas</span>
        </a>

        <!-- Item Normal -->
        <a href="{{ urlFor('admin.reservas')}}"
            class="flex items-center gap-3 px-6 py-3 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900">
            <!-- Icono: Calendar -->
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span class="font-medium text-sm">Reservas</span>
        </a>



        <!-- Item Normal -->
        <a href="/admin/settings"
            class="flex items-center gap-3 px-6 py-3 text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900">
            <!-- Icono: Cog -->
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z">
                </path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="font-medium text-sm">Settings</span>
        </a>
    </nav>

    <!-- Sección Inferior (Botón y Soporte) -->
    <div class="px-6 py-8 space-y-4 mt-auto">
        <div class="border-t border-gray-200 pt-4">

            <div class="flex items-center gap-3 px-2 mb-4">
                <div
                    class="w-10 h-10 rounded-full bg-[#1B3B32] flex items-center justify-center text-white font-bold shrink-0">
                    {{ session.get('usuario_nombre').charAt(0).toUpperCase() || 'A' }}
                </div>

                <div class="flex flex-col overflow-hidden">
                    <span class="text-sm font-bold text-gray-800 truncate">
                        {{ session.get('usuario_nombre') || 'Administrador' }}
                    </span>
                    <span class="text-xs text-slate-500 truncate">
                        Administrador
                    </span>
                </div>
            </div>

            <form action="{{ route('auth.logout') }}" method="POST">
                {{ csrfField() }}
                <button type="submit"
                    class="w-full cursor-pointer flex items-center gap-3 px-3 py-2 text-sm font-medium text-red-500 rounded-lg hover:bg-red-50 hover:text-red-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                        </path>
                    </svg>
                    Cerrar sesión
                </button>
            </form>

        </div>
    </div>
</aside>