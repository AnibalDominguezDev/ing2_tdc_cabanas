{{-- resources/views/pages/cabanas/show.edge --}}

@layout()

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <div class="w-full h-[50vh] md:h-[65vh] mb-12 overflow-hidden rounded-2xl shadow-sm">
        <img src="{{ cabana.imgUrl? await driveUrl(cabana.imgUrl) : 'https://images.unsplash.com/photo-1542718610-a1d656d1884c?w=1200&h=800&fit=crop' }}"
            alt="{{ cabana.nombre }}"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105">
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 relative">

        <div class="lg:col-span-2">

            <span
