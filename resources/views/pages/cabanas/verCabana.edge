                            </path>
                        </svg>
                        <h4 class="font-bold text-gray-900 text-sm">{{ servicio.nombre}}</h4>
                        <p class="text-xs text-gray-500 mt-2 leading-relaxed">Climatización ideal para mantener el
                            confort en cualquier temporada del año.</p>

                        @elseif(servicio.nombre === 'Fogata')
                        <svg class="w-6 h-6 text-[#1B3B32] mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z">
