                            d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                        </path>
                    </svg>
                    {{cabana.capacidad}} Huéspedes
                </div>
            </div>

            <div class="mt-10 space-y-6 text-base text-gray-600 leading-relaxed">
                <p>
                    {{cabana.descripcion}}
                </p>
                <p>

                </p>
            </div>

            <div class="mt-16">
                <h3 class="text-2xl font-serif text-[#1B3B32] mb-8">Comodidades Destacadas</h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">

                    {{-- Iteramos sobre las comodidades de la base de datos --}}
                    @each(servicio in cabana.servicios)
                    <div class="p-5 bg-[#FDFBF9] rounded-xl border border-gray-100">

                        @if(servicio.nombre === 'Wi-Fi')
                        <svg class="w-6 h-6 text-[#1B3B32] mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0">
                            </path>
                        </svg>
                        <h4 class="font-bold text-gray-900 text-sm">{{ servicio.nombre }}</h4>
                        <p class="text-xs text-gray-500 mt-2 leading-relaxed">Conectividad de alta velocidad para
                            trabajo remoto y entretenimiento.</p>

                        @elseif(servicio.nombre === 'Aire acondicionado')
                        <svg class="w-6 h-6 text-[#1B3B32] mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
