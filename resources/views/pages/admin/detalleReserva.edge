@adminLayout()

<header class="max-w-7xl space-y-8">

    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">

        <div class="max-w-2xl">

            <h2 class="mt-2 text-5xl font-serif text-[#1B3B32] leading-tight">
                Detalle de La reserva
            </h2>
            <p class="mt-4 text-gray-500 text-sm md:text-base leading-relaxed">
                Reserava: RE-{{reserva.id}}
            </p>
        </div>


    </div>
    <div class="mb-8">
        <a href="{{urlFor('admin.reservas')}}"
            class="text-sm flex items-center font-semibold text-secondary transition hover:text-primary">
            <svg class="inline w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M5 12l14 0" />
                <path d="M5 12l6 6" />
                <path d="M5 12l6 -6" />
            </svg>Volver a Reservas
        </a>
    </div>

</header>
<div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
    <section>
        <div class="overflow-hidden rounded-2xl border border-secondary/10 bg-neutral-bg shadow-sm">
            <img src="{{ reserva.cabana.imgUrl ? await driveUrl(reserva.cabana.imgUrl) : 'https://images.unsplash.com/photo-1542718610-a1d656d1884c?w=1200&h=800&fit=crop' }}"
                alt="{{ reserva.cabana.nombre }}" class="h-80 w-full object-cover">

            <div class="p-6 sm:p-8">
                <div class="mb-4 flex flex-wrap items-center gap-3">
                    <h1 class="text-4xl font-serif text-[#1B3B32]">
                        {{ reserva.cabana.nombre }}
                    </h1>

                    <span
                        class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary">
                        {{ reserva.estado.estado }}
                    </span>
                </div>

                <p class="text-sm leading-6 text-primary/70">
                    {{ reserva.cabana.descripcion }}
                </p>
            </div>
        </div>

        <section class="mt-6 rounded-2xl border border-secondary/10 bg-white p-6 shadow-sm">
            <h2 class="mb-4 text-2xl font-serif text-[#1B3B32]">
                Servicios incluidos
            </h2>

            @if(reserva.cabana.servicios.length > 0)
            <div class="grid gap-3 sm:grid-cols-2">
                @each(servicio in reserva.cabana.servicios)
                <div class="rounded-xl bg-neutral-bg px-4 py-3 text-sm font-semibold text-primary">
                    {{ servicio.nombre }}
                </div>
                @endeach
            </div>
            @else
            <p class="text-sm text-primary/70">
                Esta cabana no tiene servicios cargados.
            </p>
            @endif
        </section>
    </section>

    <aside class="space-y-6">
        <section class="rounded-2xl border border-secondary/10 bg-neutral-bg p-6 shadow-sm">
            <h2 class="mb-5 text-2xl font-serif text-[#1B3B32]">
                Detalle de la estadia
            </h2>

            <div class="space-y-4 text-sm">
                <div class="flex justify-between gap-4 border-b border-secondary/10 pb-3">
                    <span class="font-semibold text-secondary">Entrada</span>
                    <span>{{ reserva.fechaInicio.toFormat('dd/MM/yyyy') }}</span>
                </div>

                <div class="flex justify-between gap-4 border-b border-secondary/10 pb-3">
                    <span class="font-semibold text-secondary">Salida</span>
                    <span>{{ reserva.fechaFin.toFormat('dd/MM/yyyy') }}</span>
                </div>

                <div class="flex justify-between gap-4 border-b border-secondary/10 pb-3">
                    <span class="font-semibold text-secondary">Noches</span>
                    <span>{{ reserva.fechaFin.diff(reserva.fechaInicio, 'days').days }}</span>
                </div>

                <div class="flex justify-between gap-4 border-b border-secondary/10 pb-3">
                    <span class="font-semibold text-secondary">Precio por noche</span>
                    <span>${{ reserva.cabana.precioPorNoche }}</span>
                </div>

                <div class="flex justify-between gap-4 pt-1 text-lg font-bold text-[#1B3B32]">
                    <span>Total</span>
                    <span>${{ reserva.precioTotal }}</span>
                </div>
            </div>
        </section>

        <section class="rounded-2xl border border-secondary/10 bg-white p-6 shadow-sm">
            <h2 class="mb-5 text-2xl font-serif text-[#1B3B32]">
                Huespedes
            </h2>

            @if(reserva.huespedes.length > 0)
            <div class="space-y-3">
                @each(huesped in reserva.huespedes)
                <div class="rounded-xl bg-neutral-bg p-4">
                    <p class="font-semibold text-primary">
                        {{ huesped.nombre }} {{ huesped.apellido }}
                    </p>

                    <p class="mt-1 text-sm text-primary/70">
                        DNI/Pasaporte: {{ huesped.dni }}
                    </p>

                    @if(huesped.telefono)
                    <p class="mt-1 text-sm text-primary/70">
                        Telefono: {{ huesped.telefono }}
                    </p>
                    @endif
                </div>
                @endeach
            </div>
            @else
            <p class="text-sm text-primary/70">
                No hay huespedes cargados para esta reserva.
            </p>
            @endif
        </section>
    </aside>
</div>
@end