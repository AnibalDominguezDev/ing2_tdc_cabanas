@adminLayout()
<header class="max-w-7xl space-y-8">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">

        <div class="max-w-2xl">

            <h2 class="mt-2 text-5xl font-serif text-[#1B3B32] leading-tight">
                Listado de reservas
            </h2>
            <p class="mt-4 text-gray-500 text-sm md:text-base leading-relaxed">

            </p>
        </div>
    </div>

</header>

<div class="bg-white border border-gray-100 rounded-xl shadow-sm overflow-hidden mt-5">

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse whitespace-nowrap">

            <thead class="bg-[#F7F6F2] text-[10px] font-bold tracking-wider text-gray-400 uppercase">
                <tr>
                    <th scope="col" class="px-6 py-5">ID</th>
                    <th scope="col" class="px-6 py-5">Cabaña</th>
                    <th scope="col" class="px-6 py-5">Huésped</th>
                    <th scope="col" class="px-6 py-5">Check-in / Out</th>
                    <th scope="col" class="px-6 py-5">Monto</th>
                    <th scope="col" class="px-6 py-5">Estado</th>
                    <th scope="col" class="px-6 py-5 text-center">Acciones</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-gray-100 text-sm">

                @each(reserva in reservas)
                <tr class="hover:bg-gray-50/50 transition-colors">
                    <td class="px-6 py-4 font-semibold text-gray-900">
                        RE-{{ reserva.id }}
                    </td>

                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <img src="{{ reserva.cabana.imgUrl? await driveUrl(reserva.cabana.imgUrl) : 'https://placehold.co/100x100?text=No-img' }}"
                                alt="{{ reserva.cabana.nombre }}"
                                class="w-10 h-10 rounded-md object-cover border border-gray-200">
                            <span class="font-serif text-base text-gray-900">
                                {{ reserva.cabana.nombre }}
                            </span>
                        </div>
                    </td>

                    <td class="px-6 py-4">
                        <div class="flex flex-col">
                            <span class="font-medium text-gray-900">
                                {{ reserva.huespedes[0].nombre }} {{ reserva.huespedes[0].apellido }}
                            </span>
                            <span class="text-xs text-gray-400 mt-0.5">
                                {{ reserva.huespedes[0].telefono || 'Sin telefono' }}
                            </span>
                        </div>
                    </td>

                    <td class="px-6 py-4 text-gray-600">
                        {{ reserva.fechaInicio.toFormat('LLL dd') }}
                        <span class="text-gray-300 mx-1.5">&rarr;</span>
                        {{ reserva.fechaFin.toFormat('LLL dd') }}
                    </td>

                    <td class="px-6 py-4 font-medium text-gray-900">
                        ${{ reserva.precioTotal.toLocaleString('es-AR', { minimumFractionDigits: 2 }) }}
                    </td>

                    <td class="px-6 py-4">
                        @if(reserva.idEstadoReserva === 1 || reserva.estado === 'Pendiente')
                        <span
                            class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-orange-100 text-orange-700">
                            Pendiente
                        </span>
                        @elseif(reserva.idEstadoReserva === 2 || reserva.estado === 'Activa')
                        <span
                            class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-green-100 text-green-700">

                            Activa
                        </span>
                        @elseif(reserva.idEstadoReserva === 3 || reserva.estado === 'Finalizada')
                        <span
                            class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-gray-100 text-gray-600">
                            Completada
                        </span>
                        @else
                        <span
                            class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-red-100 text-red-700">
                            Cancelada
                        </span>
                        @end
                    </td>

                    <td class="px-6 py-4 text-center">
                        <a href="{{urlFor('admin.detalleReserva', { id: reserva.id }) }}" title="Ver Detalles"
                            class="inline-block text-slate-400 hover:text-[#1B3B32] transition-colors p-1">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                                <path
                                    d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                            </svg>
                        </a>
                    </td>
                </tr>
                @else
                <tr>
                    <td colspan="7" class="px-6 py-12 text-center text-sm text-gray-500 font-medium">
                        No se encontraron reservas registradas en el sistema.
                    </td>
                </tr>
                @end

            </tbody>
        </table>
    </div>

    <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between bg-white">
        <span class="text-sm text-gray-500">Página 1 de 1</span>

        <div class="flex items-center gap-1">
            <button disabled class="p-2 text-gray-300 cursor-not-allowed">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
            </button>
            <span
                class="w-8 h-8 flex items-center justify-center rounded-full bg-[#1B3B32] text-white text-sm font-medium">1</span>
            <button disabled class="p-2 text-gray-300 cursor-not-allowed">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
        </div>
    </div>


</div>
@end