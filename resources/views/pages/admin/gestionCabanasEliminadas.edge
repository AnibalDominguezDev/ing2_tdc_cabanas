@adminLayout()
<header class="max-w-7xl space-y-8">

    <!-- Sección de Cabecera (Títulos y Acciones) -->
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">

        <!-- Títulos y Descripción -->
        <div class="max-w-2xl">

            <h2 class="mt-2 text-5xl font-serif text-[#1B3B32] leading-tight">
                Inventario de Cabañas y Gestion
            </h2>
            <p class="mt-4 text-gray-500 text-sm md:text-base leading-relaxed">
                Gestiona tus cabañas eliminadas
            </p>
        </div>



    </div>

    <!-- Grid de Tarjetas de Métricas -->

    <div class="flex flex-col gap-2 shrink-0">
        <div class="flex items-center gap-3">
            <!-- Botón Filter -->
            <a href="{{urlFor('gestion')}}"
                class="flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-gray-800 bg-[#F0EEEB] rounded-md hover:bg-gray-200 transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M5 12l14 0" />
                    <path d="M5 12l6 6" />
                    <path d="M5 12l6 -6" />
                </svg>
                Volver a cabanas activas
            </a>

        </div>

    </div>


</header>

<div class="bg-white border border-gray-100 rounded-xl shadow-sm overflow-hidden mt-5">

    <!-- Cabecera de la Tabla -->
    <div class="px-6 py-5 flex items-center justify-between bg-white">
        <h3 class="text-xl font-serif text-[#1B3B32]">Cabañas eliminadas</h3>

    </div>

    <!-- Contenedor de la Tabla -->
    <div class="overflow-x-auto m-4">
        <table class="w-full text-left border-collapse">
            <!-- Títulos de Columnas -->
            <thead class="bg-[#FCFBF9] border-y border-gray-100">
                <tr>
                    <th class="px-6 py-4 text-xs font-bold tracking-wider text-gray-500 uppercase">Cabaña</th>
                    <th class="px-6 py-4 text-xs font-bold tracking-wider text-gray-500 uppercase">Capacidad</th>
                    <th class="px-6 py-4 text-xs font-bold tracking-wider text-gray-500 uppercase ">Estado</th>
                    <th class="px-6 py-4 text-xs font-bold tracking-wider text-gray-500 uppercase">Precio / Noche</th>
                    <th class="px-6 py-4 text-xs font-bold tracking-wider text-gray-500 uppercase ">Acciones
                    </th>
                </tr>
            </thead>

            <!-- Filas de Datos -->
            <tbody class="divide-y divide-gray-100 bg-white">

                {{-- Aquí iteramos sobre los datos enviados desde tu controlador de AdonisJS --}}
                @each(cabin in cabanas)
                <tr class="hover:bg-gray-50 transition-colors group">


                    <td class="px-6 py-4">
                        <div class="flex items-center gap-4">
                            <img src="{{ cabin.imgUrl? await driveUrl(cabin.imgUrl) : 'https://placehold.co/100x100?text=No-img' }}"
                                alt="{{ cabin.nombre }}" class="w-12 h-12 rounded-lg object-cover shadow-sm">
                            <div>
                                <p class="text-sm font-bold text-[#1B3B32]">{{ cabin.nombre }}</p>

                            </div>
                        </div>
                    </td>

                    <!-- Ubicación -->
                    <td class="px-6 py-4">
                        <p class="text-sm text-gray-600">{{ cabin.capacidad }} Personas</p>
                        <p class="text-[10px] text-gray-400 mt-0.5">{{ cabin.habitaciones }} Habitaciones</p>
                    </td>

                    <!-- Estado (Badge dinámico) -->
                    <td class="px-6 py-4">
                        @if(cabin.nombreEstado === 'Disponible')
                        <span
                            class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-bold tracking-wider text-[#2B453D] uppercase bg-[#E9F0EC] border border-[#D5E5DD] rounded-full">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#2B453D]"></span>
                            Disponible
                        </span>
                        @elseif(cabin.nombreEstado === 'Eliminado')
                        <span
                            class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-bold tracking-wider text-[#8A352F] uppercase bg-[#FCEDEB] border border-[#F2D6D3] rounded-full">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#8A352F]"></span>
                            Eliminado
                        </span>
                        @elseif(cabin.nombreEstado === 'Mantenimiento')
                        <span
                            class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-bold tracking-wider text-[#7D5537] uppercase bg-[#F6EBE1] border border-[#EADDCE] rounded-full">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#7D5537]"></span>
                            Mantenimiento
                        </span>
                        @endif
                    </td>

                    <!-- Precio -->
                    <td class="px-6 py-4">
                        <span class="text-sm font-semibold text-gray-700">${{
                            cabin.precioPorNoche.toLocaleString('es-AR') }}</span>
                    </td>

                    <!-- Acciones -->
                    <td class="px-6 py-4 ">
                        <!-- Botón de edición que aparece al hacer hover -->
                        <div class="flex items-center gap-1">

                            <a href="{{ urlFor('cabanas.mostrar', { slug: cabin.slug }) }}" title="Vista previa"
                                class="text-gray-400 hover:text-blue-500 transition-colors p-1">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                    fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                                    <path
                                        d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                                </svg>
                            </a>


                            <a href="{{ urlFor('cabana.reactivar', { id: cabin.id }) }}" title="Reactivar cabaña"
                                class="text-gray-400 hover:text-green-500 transition-colors p-1">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                    fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M7 6a7.75 7.75 0 1 0 10 0" />
                                    <path d="M12 4l0 8" />
                                </svg>
                            </a>


                        </div>
                    </td>

                </tr>
                @endeach

            </tbody>
        </table>
    </div>
</div>
@end