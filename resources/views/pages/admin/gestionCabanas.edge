@adminLayout()
<header class="max-w-7xl space-y-8">

    <!-- Sección de Cabecera (Títulos y Acciones) -->
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">

        <!-- Títulos y Descripción -->
        <div class="max-w-2xl">

            <h2 class="mt-2 text-5xl font-serif text-[#1B3B32] leading-tight">
                Inventario de Cabañas y Gestion
            </h2>
            <p class="mt-4 text-gray-500 text-sm md:text-base leading-relaxed">
                Gestiona y supervisa tu colección de refugios de lujo en plena naturaleza. Gestiona
                la
                disponibilidad.
            </p>
        </div>



    </div>

    <!-- Grid de Tarjetas de Métricas -->

    <div class="flex flex-col gap-2 shrink-0">
        <div class="flex items-center gap-3">
            <!-- Botón Filter -->
            <a href="{{urlFor('cabanas.eliminadas')}}"
                class="flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-gray-800 bg-[#F0EEEB] rounded-md hover:bg-gray-200 transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M4 7l16 0" />
                    <path d="M10 11l0 6" />
                    <path d="M14 11l0 6" />
                    <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                    <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                </svg>
                Ver eliminadas
            </a>

            <!-- Botón Add New -->
            <a href="{{urlFor('nuevaCabana')}}"
                class="flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-[#1B3B32] rounded-md hover:bg-[#122822] transition-colors shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Nueva cabaña
            </a>
