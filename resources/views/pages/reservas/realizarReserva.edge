<script>

    document.addEventListener('alpine:init', () => {

        // 1. Le pedimos a Edge que traiga los datos de forma simple.
        // Si no hay datos, le decimos que imprima la palabra 'null' o '{}'.
        const huespedesDesdeServidor = {{{ flashMessages.has('huespedes') ? JSON.stringify(flashMessages.get('huespedes')) : 'null'
    }}};
    const serverErrors = {{{ flashMessages.has('errors') ? JSON.stringify(flashMessages.get('errors')) : '{}' }}};

    // 2. Aplicamos el valor por defecto usando JavaScript puro (esto evita que Edge colapse)
    const oldhuespedes = huespedesDesdeServidor || [{ nombre: '', apellido: '', documento: '', telefono: '' }];

    // 3. Les asignamos un ID aleatorio para Alpine
    const huespedesRecuperados = oldhuespedes.map(a => ({ ...a, id: Date.now() + Math.random() }));

    Alpine.data('bookingCalculator', () => ({

        erroresServidor: serverErrors,

        get hayErrorhuespedes() {
            // Revisa si VineJS mandó algún error que tenga la palabra "huespedes"
            return Object.keys(this.erroresServidor).some(llave => llave.includes('huespedes'));
        },
        maxhuespedes: {{ cabana.capacidad || 0 }},
        huespedes: huespedesRecuperados,


        precioNoche: {{ cabana.precioPorNoche || 240 }},
        limpieza: 85,
        servicio: 115,
        noches: 0,
        checkinDate: null,
        checkoutDate: null,

        // Variables para guardar los calendarios
        fpCheckin: null,
        fpCheckout: null,

        maxhuespedes: {{ cabana.capacidad - 1 || 0 }}, // Traemos la capacidad real desde el modelo
        huespedes: [], // Empezamos sin acompañantes extra

        addAcompanante() {
        // Solo agrega si no superamos la capacidad máxima de acompañantes
        if(this.huespedes.length < this.maxhuespedes ) {
        // Usamos Date.now() como un ID único e irrepetible para que Alpine no confunda las cajas
        this.huespedes.push({ id: Date.now() });
    }
            },

    removeAcompanante(id) {
        // Filtramos el array descartando el ID que el usuario seleccionó eliminar
        this.huespedes = this.huespedes.filter(persona => persona.id !== id);
    },

        get subtotal() { return this.noches * this.precioNoche; },
        get total() { return this.noches > 0 ? this.subtotal + this.limpieza + this.servicio : 0; },

    init() {

        this.fpCheckout = flatpickr(this.$refs.checkout, {
            locale: 'es',
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: "d / m / Y",
            onChange: (selectedDates) => {
                this.checkoutDate = selectedDates[0];
                this.calculateNights();
            }
        });

        // 2. Iniciamos el Check-in
        this.fpCheckin = flatpickr(this.$refs.checkin, {
            minDate: 'today',
            locale: 'es',
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: "d / m / Y",
            onChange: (selectedDates) => {
                this.checkinDate = selectedDates[0];

                // Forzamos que el checkout sea mínimo 1 día después
                this.fpCheckout.set('minDate', selectedDates[0].fp_incr(1));

                // Si el checkout actual es inválido, lo limpiamos
                if (this.checkoutDate && this.checkoutDate <= this.checkinDate) {
                    this.fpCheckout.clear();
                    this.checkoutDate = null;
                }

                this.calculateNights();


                setTimeout(() => {
                    this.fpCheckout.open();
                }, 100);
            }
        });
    },

    calculateNights() {
        if (this.checkinDate && this.checkoutDate) {

            const diffTime = Math.abs(this.checkoutDate - this.checkinDate);
            this.noches = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        } else {
            this.noches = 0;
        }
    }
    }))
  })
</script>


@end