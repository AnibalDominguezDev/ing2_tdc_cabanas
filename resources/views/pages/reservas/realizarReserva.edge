@layout()
<div x-data="bookingCalculator" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 bg-[#FFFEFC] min-h-screen">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

        <div class="lg:col-span-7">
            <h1 class="text-4xl md:text-5xl font-serif text-[#1B3B32] mb-4">Finaliza tu Reserva</h1>
            <p class="text-gray-500 text-sm md:text-base leading-relaxed mb-10 max-w-2xl">
                Completa los detalles a continuación para asegurar tu refugio en el corazón del bosque. Tu estancia de
                quietud comienza aquí.
            </p>

            <form id="reservaForm" action="{{ route('reservas.store', { slug: cabana.slug }) }}" method="POST"
                novalidate class="space-y-10" x-on:submit="beforeSubmit">

                {{ csrfField() }}
                <input type="hidden" name="cabanaId" value="{{ cabana.id }}">

                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <svg class="w-5 h-5 text-[#1B3B32]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                            </path>
                        </svg>
                        <h3 class="text-xl font-serif text-[#1B3B32]">Fechas de Estancia</h3>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div
                            class="bg-[#F7F6F2] p-4 rounded-xl flex justify-between items-center border border-transparent focus-within:border-[#1B3B32] transition-colors">
                            <div class="w-full">
                                <label
                                    class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">Check-in</label>
                                <input x-ref="checkin" type="text" name="checkin" placeholder="Selecciona una fecha"
                                    value="{{ old('checkin') || '' }}"
                                    class="w-full bg-transparent border-none p-0 text-gray-800 focus:ring-0 text-sm font-medium outline-none">
                            </div>
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                                </path>
                            </svg>
                        </div>

                        <div
                            class="bg-[#F7F6F2] p-4 rounded-xl flex justify-between items-center border border-transparent focus-within:border-[#1B3B32] transition-colors">
                            <div class="w-full">
                                <label
                                    class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">Check-out</label>
                                <input x-ref="checkout" type="text" name="checkout" placeholder="Primero elige check-in"
                                    value="{{ old('checkout') || '' }}"
                                    class="w-full bg-transparent border-none p-0 text-gray-800 focus:ring-0 text-sm font-medium outline-none disabled:cursor-not-allowed disabled:text-gray-400">
                            </div>
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                                </path>
                            </svg>
                        </div>
                    </div>

                    <p x-show="dateError || erroresServidor.checkin || erroresServidor.checkout" x-cloak
                        class="mt-3 text-sm font-medium text-red-600"
                        x-text="dateError || (erroresServidor.checkin && erroresServidor.checkin.join(', ')) || (erroresServidor.checkout && erroresServidor.checkout.join(', '))">
                    </p>

                </div>


                <div>
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-2">
                                <svg class="w-5 h-5 text-[#1B3B32]" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                        d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                                    </path>
                                </svg>
                                <h3 class="text-xl font-serif text-[#1B3B32]">Información de los Huéspedes</h3>
                            </div>

                            <button type="button" x-show="huespedes.length < maxhuespedes" x-on:click="addAcompanante()"
                                class="text-[10px] font-bold tracking-wider text-gray-400 uppercase hover:text-[#1B3B32] transition-colors flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 4v16m8-8H4"></path>
                                </svg>
                                Añadir Acompañante
                            </button>
                        </div>

                        <div class="bg-[#F7F6F2] p-6 rounded-r-xl rounded-l-sm border-l-4 border-[#1B3B32] mb-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label
                                        class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">Nombre</label>
                                    <input type="text" name="nombre" placeholder="Ej. Julian"
                                        value="{{session.get('usuario_nombre') || old('nombre') || '' }}"
                                        class="w-full bg-white border rounded-md px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-1 transition-colors shadow-sm"
                                        :class="erroresServidor.nombre ? 'border-red-500 ring-1 ring-red-500' : 'border-transparent focus:border-[#1B3B32] focus:ring-[#1B3B32]'">
                                    <template x-if="erroresServidor.nombre">
                                        <span class="text-red-500 text-[10px] mt-1 font-semibold block"
                                            x-text="erroresServidor.nombre.join(', ')"></span>
                                    </template>
                                </div>
                                <div>
                                    <label
                                        class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">Apellido</label>
                                    <input type="text" name="apellido" placeholder="Ej. Moretti"
                                        value="{{ session.get('usuario_apellido') || old('apellido') || '' }}"
                                        class="w-full bg-white border rounded-md px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-1 transition-colors shadow-sm"
                                        :class="erroresServidor.apellido ? 'border-red-500 ring-1 ring-red-500' : 'border-transparent focus:border-[#1B3B32] focus:ring-[#1B3B32]'">
                                    <template x-if="erroresServidor.apellido">
                                        <span class="text-red-500 text-[10px] mt-1 font-semibold block"
                                            x-text="erroresServidor.apellido.join(', ')"></span>
                                    </template>
                                </div>
                                <div>
                                    <label
                                        class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">DNI</label>
                                    <input type="text" name="documento" placeholder="Documento de identidad"
                                        value="{{ session.get('usuario_dni') || old('documento') || '' }}"
                                        class="w-full bg-white border rounded-md px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-1 transition-colors shadow-sm"
                                        :class="erroresServidor.documento ? 'border-red-500 ring-1 ring-red-500' : 'border-transparent focus:border-[#1B3B32] focus:ring-[#1B3B32]'">
                                    <template x-if="erroresServidor.documento">
                                        <span class="text-red-500 text-[10px] mt-1 font-semibold block"
                                            x-text="erroresServidor.documento.join(', ')"></span>
                                    </template>
                                </div>
                                <div>
                                    <label
                                        class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">Teléfono
                                        (Opcional)</label>
                                    <input type="tel" name="telefono" placeholder="+54 000 000 000"
                                        value="{{ old('telefono') || '' }}"
                                        class="w-full bg-white border rounded-md px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-1 transition-colors shadow-sm"
                                        :class="erroresServidor.telefono ? 'border-red-500 ring-1 ring-red-500' : 'border-transparent focus:border-[#1B3B32] focus:ring-[#1B3B32]'">
                                    <template x-if="erroresServidor.telefono">
                                        <span class="text-red-500 text-[10px] mt-1 font-semibold block"
                                            x-text="erroresServidor.telefono.join(', ')"></span>
                                    </template>
                                </div>
                            </div>
                        </div>

                        <div x-show="hayErrorhuespedes" x-cloak
                            class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl mb-4 text-sm font-medium mt-4">
                            Revisa los datos de los acompanantes marcados.
                        </div>

                        <template x-for="(acompanante, index) in huespedes" :key="acompanante.id">
                            <div class="bg-[#F7F6F2] p-6 rounded-xl border border-gray-100 relative mt-4">

                                <div class="flex justify-between items-center mb-4">
                                    <h4 class="text-xs font-bold text-gray-500 uppercase tracking-widest"
                                        x-text="`Acompañante ${index + 1}`"></h4>
                                    <button type="button" x-on:click="removeAcompanante(acompanante.id)"
                                        class="text-gray-400 hover:text-red-500 transition-colors p-1"
                                        title="Eliminar acompañante">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                            </path>
                                        </svg>
                                    </button>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                                    <div>
                                        <label
                                            class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">Nombre</label>
                                        <input type="text" x-bind:name="`huespedes[${index}][nombre]`"
                                            x-model="acompanante.nombre" placeholder="Ej. Pedro"
                                            class="w-full bg-white border rounded-md px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-1 transition-colors shadow-sm"
                                            :class="erroresServidor[`huespedes.${index}.nombre`] ? 'border-red-500 ring-1 ring-red-500' : 'border-transparent focus:border-[#1B3B32] focus:ring-[#1B3B32]'">

                                        <template x-if="erroresServidor[`huespedes.${index}.nombre`]">
                                            <span class="text-red-500 text-[10px] mt-1 font-semibold block"
                                                x-text="erroresServidor[`huespedes.${index}.nombre`].join(', ')"></span>
                                        </template>
                                    </div>

                                    <div>
                                        <label
                                            class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">Apellido</label>
                                        <input type="text" x-bind:name="`huespedes[${index}][apellido]`"
                                            x-model="acompanante.apellido" placeholder="Ej. Pascal"
                                            class="w-full bg-white border rounded-md px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-1 transition-colors shadow-sm"
                                            :class="erroresServidor[`huespedes.${index}.apellido`] ? 'border-red-500 ring-1 ring-red-500' : 'border-transparent focus:border-[#1B3B32] focus:ring-[#1B3B32]'">
                                        <template x-if="erroresServidor[`huespedes.${index}.apellido`]">
                                            <span class="text-red-500 text-[10px] mt-1 font-semibold block"
                                                x-text="erroresServidor[`huespedes.${index}.apellido`].join(', ')"></span>
                                        </template>
                                    </div>

                                    <div>
                                        <label
                                            class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">DNI
                                        </label>
                                        <input type="text" x-bind:name="`huespedes[${index}][documento]`"
                                            x-model="acompanante.documento" placeholder="Sin puntos ni espacios"
                                            class="w-full bg-white border rounded-md px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-1 transition-colors shadow-sm"
                                            :class="erroresServidor[`huespedes.${index}.documento`] ? 'border-red-500 ring-1 ring-red-500' : 'border-transparent focus:border-[#1B3B32] focus:ring-[#1B3B32]'">
                                        <template x-if="erroresServidor[`huespedes.${index}.documento`]">
                                            <span class="text-red-500 text-[10px] mt-1 font-semibold block"
                                                x-text="erroresServidor[`huespedes.${index}.documento`].join(', ')"></span>
                                        </template>
                                    </div>

                                    <div>
                                        <label
                                            class="block text-[10px] font-bold tracking-wider text-gray-400 uppercase mb-1">Teléfono
                                            (Opcional)</label>
                                        <input type="tel" x-bind:name="`huespedes[${index}][telefono]`"
                                            x-model="acompanante.telefono" placeholder="Ej. 3794123456"
                                            class="w-full bg-white border rounded-md px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-1 transition-colors shadow-sm"
                                            :class="erroresServidor[`huespedes.${index}.telefono`] ? 'border-red-500 ring-1 ring-red-500' : 'border-transparent focus:border-[#1B3B32] focus:ring-[#1B3B32]'">
                                        <template x-if="erroresServidor[`huespedes.${index}.telefono`]">
                                            <span class="text-red-500 text-[10px] mt-1 font-semibold block"
                                                x-text="erroresServidor[`huespedes.${index}.telefono`].join(', ')"></span>
                                        </template>
                                    </div>

                                </div>
                            </div>
                        </template>

                    </div>
                </div>
            </form>
        </div>

        <div class="lg:col-span-5">
            <div
                class="bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100 overflow-hidden sticky top-8">

                <div class="relative h-48 bg-gray-200">
                    <img src="{{ cabana.imageUrl || 'https://images.unsplash.com/photo-1542718610-a1d656d1884c?w=800&h=400&fit=crop' }}"
                        class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 to-transparent"></div>
                    <div class="absolute bottom-4 left-6 right-6">
                        <h3 class="text-2xl font-serif text-white">{{ cabana.nombre }}</h3>
                    </div>
                </div>



                <div class="p-6 sm:p-8">

                    <div x-show="noches === 0" x-cloak
                        class="text-center py-4 text-sm text-gray-500 border-b border-gray-100 mb-6">
                        Selecciona tus fechas de estadía para ver el desglose del precio.
                    </div>

                    <div x-show="noches > 0" x-cloak
                        class="space-y-4 text-sm text-gray-600 border-b border-gray-100 pb-6 mb-6">
                        <div class="flex justify-between">
                            <span x-text="`${noches} noches x $${precioNoche}`"></span>
                            <span class="font-medium text-gray-900" x-text="`$${subtotal}`"></span>
                        </div>

                    </div>

                    <div class="flex justify-between items-center mb-6">
                        <span class="text-lg font-serif text-[#1B3B32]">Total</span>
                        <span class="text-2xl font-serif text-[#1B3B32]"
                            x-text="`$${total.toLocaleString('es-AR')}`"></span>
                    </div>

                    <button type="submit" form="reservaForm"
                        class="w-full py-4 bg-[#1B3B32] hover:bg-[#122822] text-white text-sm font-bold tracking-wider rounded-xl transition-colors shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
                        :disabled="!canSubmit">
                        Confirmar Reserva
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        const huespedesDesdeServidor = {{{ flashMessages.has('huespedes') ? JSON.stringify(flashMessages.get('huespedes')) : 'null'
    }}};
    const serverErrors = {{{ flashMessages.has('errors') ? JSON.stringify(flashMessages.get('errors')) : '{}' }}};
    const rangosOcupados = {{{ JSON.stringify(rangosOcupados || []) }}};
    const oldCheckin = "{{ old('checkin') || '' }}";
    const oldCheckout = "{{ old('checkout') || '' }}";

    const oldhuespedes = huespedesDesdeServidor || [];
    const huespedesRecuperados = oldhuespedes.map((acompanante) => ({
        ...acompanante,
        id: Date.now() + Math.random(),
    }));

    Alpine.data('bookingCalculator', () => ({
        erroresServidor: serverErrors,
        rangosOcupados,
        maxhuespedes: {{ cabana.capacidad - 1 || 0 }},
        huespedes: huespedesRecuperados,
        precioNoche: {{ cabana.precioPorNoche || 240 }},
        limpieza: 0,
        servicio: 0,
        noches: 0,
        checkinDate: null,
        checkoutDate: null,
        dateError: '',
        fpCheckin: null,
        fpCheckout: null,

        get hayErrorhuespedes() {
        return Object.keys(this.erroresServidor).some((llave) => llave.includes('huespedes'));
    },

        get subtotal() {
        return this.noches * this.precioNoche;
    },

        get total() {
        return this.noches > 0 ? this.subtotal + this.limpieza + this.servicio : 0;
    },

        get canSubmit() {
        return this.noches > 0 && !this.dateError;
    },

        addAcompanante() {
        if(this.huespedes.length < this.maxhuespedes) {
        this.huespedes.push({ id: Date.now(), nombre: '', apellido: '', documento: '', telefono: '' });
    }
            },

    removeAcompanante(id) {
        this.huespedes = this.huespedes.filter((persona) => persona.id !== id);
    },

    init() {
        const disabledRanges = this.rangosOcupados.map((rango) => ({
            from: rango.inicio,
            to: this.previousDate(rango.fin),
        }));

        this.fpCheckout = flatpickr(this.$refs.checkout, {
            minDate: 'today',
            disable: disabledRanges,
            locale: 'es',
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: 'd / m / Y',
            onDayCreate: (_selectedDates, _dateStr, _instance, dayElem) => this.paintDay(dayElem),
            onChange: (selectedDates) => {
                this.checkoutDate = selectedDates[0] || null;
                this.calculateNights();
            },
        });

        this.fpCheckout.input.disabled = false;
        if (this.fpCheckout.altInput) {
            this.fpCheckout.altInput.disabled = true;
            this.fpCheckout.altInput.placeholder = 'Primero elige check-in';
        }

        this.fpCheckin = flatpickr(this.$refs.checkin, {
            minDate: 'today',
            disable: disabledRanges,
            locale: 'es',
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: 'd / m / Y',
            onDayCreate: (_selectedDates, _dateStr, _instance, dayElem) => this.paintDay(dayElem),
            onChange: (selectedDates) => this.handleCheckinChange(selectedDates[0] || null),
        });

        if (oldCheckin) {
            this.fpCheckin.setDate(oldCheckin, false);
            this.handleCheckinChange(this.parseDate(oldCheckin), false);
        }

        if (oldCheckout) {
            this.fpCheckout.setDate(oldCheckout, false);
            this.checkoutDate = this.parseDate(oldCheckout);
            this.calculateNights();
        }
    },

    handleCheckinChange(date, openCheckout = true) {
        this.checkinDate = date;
        this.checkoutDate = null;
        this.dateError = '';
        this.noches = 0;
        this.fpCheckout.clear();

        if (!date) {
            this.setCheckoutEnabled(false);
            return;
        }

        const minCheckout = this.addDays(date, 1);
        const nextOccupiedStart = this.nextOccupiedStartAfter(date);

        this.fpCheckout.set('minDate', minCheckout);
        this.fpCheckout.set('maxDate', nextOccupiedStart || null);
        this.setCheckoutEnabled(true);

        if (openCheckout) {
            setTimeout(() => this.fpCheckout.open(), 100);
        }
    },

    setCheckoutEnabled(enabled) {
        this.fpCheckout.input.disabled = false;
        if (this.fpCheckout.altInput) {
            this.fpCheckout.altInput.disabled = !enabled;
            this.fpCheckout.altInput.placeholder = enabled ? 'Selecciona una fecha' : 'Primero elige check-in';
        }
    },

    calculateNights() {
        this.dateError = '';

        if (!this.checkinDate || !this.checkoutDate) {
            this.noches = 0;
            return;
        }

        if (this.checkoutDate <= this.checkinDate) {
            this.noches = 0;
            this.dateError = 'La fecha de salida debe ser posterior a la de entrada.';
            return;
        }

        if (this.hasBlockedNight(this.checkinDate, this.checkoutDate)) {
            this.noches = 0;
            this.dateError = 'Ese rango contiene fechas ya reservadas.';
            return;
        }

        const diffTime = this.checkoutDate - this.checkinDate;
        this.noches = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    },

    beforeSubmit(event) {
        this.calculateNights();

        if (!this.canSubmit) {
            event.preventDefault();
            this.dateError = this.dateError || 'Selecciona fechas disponibles para confirmar la reserva.';
        }
    },

    hasBlockedNight(checkin, checkout) {
        return this.rangosOcupados.some((rango) => {
            const inicio = this.parseDate(rango.inicio);
            const fin = this.parseDate(rango.fin);

            return inicio < checkout && fin > checkin;
        });
    },

    nextOccupiedStartAfter(date) {
        const current = this.formatDate(date);
        const next = this.rangosOcupados
            .map((rango) => rango.inicio)
            .filter((inicio) => inicio > current)
            .sort()[0];

        return next || null;
    },

    paintDay(dayElem) {
        const date = dayElem.dateObj;
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        if (date < today) {
            return;
        }

        dayElem.classList.add(this.isOccupiedDay(date) ? 'reserva-dia-ocupado' : 'reserva-dia-disponible');
    },

    isOccupiedDay(date) {
        return this.rangosOcupados.some((rango) => {
            const inicio = this.parseDate(rango.inicio);
            const fin = this.parseDate(rango.fin);

            return date >= inicio && date < fin;
        });
    },

    parseDate(value) {
        return flatpickr.parseDate(value, 'Y-m-d');
    },

    formatDate(date) {
        return flatpickr.formatDate(date, 'Y-m-d');
    },

    addDays(date, days) {
        const next = new Date(date);
        next.setDate(next.getDate() + days);
        return next;
    },

    previousDate(value) {
        const date = this.parseDate(value);
        date.setDate(date.getDate() - 1);
        return this.formatDate(date);
    },
        }));
    });
</script>


@end